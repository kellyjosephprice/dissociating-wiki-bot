# Copy to .env and fill in.

# Bluesky. Use an APP PASSWORD, not your account password:
# Settings -> Privacy and security -> App passwords
BLUESKY_HANDLE=yourname.bsky.social
BLUESKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Anthropic API key, for normalizing trending topics into entity names.
ANTHROPIC_API_KEY=sk-ant-...

# Wikipedia requires a descriptive User-Agent with a contact address on every
# request. Generic or missing UAs get rate-limited or blocked, and it tends to
# bite once the bot is running unattended rather than during development.
BOT_CONTACT=you@example.com

# Optional. User-Agent for upload.wikimedia.org (the media CDN), which has a
# DIFFERENT policy from the API host: it rejects identifying User-Agents.
# Leave unset unless you know the CDN accepts yours. See README.
# WIKIMEDIA_MEDIA_UA=
